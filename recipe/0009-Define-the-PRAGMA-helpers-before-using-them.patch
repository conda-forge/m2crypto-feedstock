From 4444444444444444444444444444444444444444 Mon Sep 17 00:00:00 2001
From: conda-forge <conda-forge@anaconda.com>
Date: Thu, 28 Aug 2026 12:00:00 +0000
Subject: [PATCH] Define the PRAGMA_ helpers before using them

PRAGMA_IGNORE_UNUSED_LABEL and PRAGMA_WARN_STRICT_PROTOTYPES come from
_lib.h but were used before it is included. clang also defines __GNUC__
(as 4), so the guard fires on macOS and the build fails with "unknown type
name 'PRAGMA_IGNORE_UNUSED_LABEL'". Move the block after the _lib.h include
and exclude clang, as upstream does in 0.48.0.
---
--- a/src/SWIG/_m2crypto.i
+++ b/src/SWIG/_m2crypto.i
@@ -43,15 +43,18 @@ typedef unsigned __int64 uint64_t;
 %}
 
 %{
-#if defined __GNUC__ && __GNUC__ < 5
-PRAGMA_IGNORE_UNUSED_LABEL
-PRAGMA_WARN_STRICT_PROTOTYPES
-#endif
-
 #include <openssl/err.h>
 #include <openssl/rand.h>
 #include <_lib.h>
 
+/* _lib.h defines PRAGMA_* helpers; only needed for old GCC (clang defines
+ * __GNUC__ too, but doesn't need this workaround).
+ */
+#if defined(__GNUC__) && !defined(__clang__) && (__GNUC__ < 5)
+PRAGMA_IGNORE_UNUSED_LABEL
+PRAGMA_WARN_STRICT_PROTOTYPES
+#endif
+
 #include "compile.h"
 
 static PyObject *ssl_verify_cb_func;
